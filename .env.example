# 首次直接运行 bash deploy.sh：缺少 .env 时复制本文件并自动生成四项随机密钥。
# 手工复制本文件时，必须先替换 replace-with-random-hex（推荐 openssl rand -hex 24）。
# .env 是 Docker Compose 配置文件，绝不是 shell 脚本；不要 source .env。

# === 部署标识：首次确定后不要随意改变，否则会使用另一套数据卷 ===
COMPOSE_PROJECT_NAME=atoms-demo
# 空值自动使用 <COMPOSE_PROJECT_NAME>_agent_workspaces；多实例必须不同。
WORKSPACE_VOLUME=
AGENT_IMAGE=atoms-demo-backend
FRONTEND_IMAGE=atoms-demo-frontend

# === 浏览器访问地址 ===
# 远程部署推荐 bash deploy.sh --host 服务器公网IP，自动更新下面两个地址。
APP_PUBLIC_URL=http://localhost:25173
# 留空时前端自动使用浏览器当前主机 + PREVIEW_PORT。
VITE_PREVIEW_ORIGIN=
# 自定义已发布应用的 Host 路由，普通部署留空。
PUBLISH_PUBLIC_HOST=
# HTTP 用 false；配好 HTTPS 后改 true。
AUTH_SECURE_COOKIE=false

# === 端口：仅前端/预览默认允许外部访问；云安全组需另行放行 ===
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=25173
PREVIEW_BIND=0.0.0.0
PREVIEW_PORT=28082
BACKEND_BIND=127.0.0.1
BACKEND_PORT=28080
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=25432
MINIO_API_PORT=29117
MINIO_CONSOLE_PORT=29118

# === PostgreSQL / MinIO（首次自动生成密码；已初始化后不要仅改 .env 的数据库密码） ===
POSTGRES_DB=atoms_demo
POSTGRES_USER=atoms
# 数据库 URL 中使用此密码：只用字母/数字/点/下划线/~/-，避免 URL 编码问题。
POSTGRES_PASSWORD=replace-with-random-hex
MINIO_ROOT_USER=atoms-minio
MINIO_ROOT_PASSWORD=replace-with-random-hex
MINIO_BUCKET=atoms-published
MINIO_REGION=us-east-1

# === AI：空值允许平台启动；实际 AI 开发必须填写有效服务/模型/额度 ===
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-6-luna
# 兼容 OpenAI Chat Completions；AI_BASE_URL 也支持完整 /chat/completions 入口。
AI_UNDERSTAND_MODEL=
AI_PLAN_MODEL=
AI_IMPLEMENT_MODEL=
AI_REVIEW_MODEL=
# 语音转写可独立配置；key 空值回退 AI_API_KEY。
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://openrouter.ai/api/v1

# === Agent：服务间密钥不会暴露给前端；已有部署请保持原值 ===
AGENT_SECRET=
AGENT_SERVICES=http://agent-service:9001
AGENT_MAX_ITERATIONS=200
AGENT_MAX_TOKENS=15000000
AGENT_BUILD_NORMAL_MULTIPLIER=1
AGENT_BUILD_DEEP_MULTIPLIER=2
AGENT_BUILD_ADVANCED_MULTIPLIER=3
AGENT_CONTEXT_TOKENS=512000
# 留空沿用代码策略；配置时填写正整数秒。
AGENT_TIMEOUT_SECONDS=
PROJECT_RSS_LIMIT_MB=1536
MAX_RUNNING_PROJECTS=8
MAX_RETAINED_PROJECTS=20
PROJECT_IDLE_SECONDS=120
PROJECT_COLD_SECONDS=300
PROJECT_HOT_SECONDS=3600
PROJECT_MEMORY_MB=4096
PROJECT_CPUS=2
PROJECT_PIDS_LIMIT=512

# === 可选本地视觉：默认不下载模型，不要求 GPU；支持图片的远程模型可直接使用 ===
ENABLE_LOCAL_VISION=false
VISION_GPU=false
VISION_URL=http://vision:11434
VISION_MODEL=qwen2.5vl:3b

# === 可选 OAuth / 连接器，未用无需填写 ===
# JSON 必须用单引号包裹，例如 '{"GitHub":"https://your-service.example/oauth/github"}'
ACCOUNT_CONNECTOR_AUTH_URLS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 填写真实控制台地址，必须和 GitHub OAuth App 配置一致。
GITHUB_CALLBACK_URL=
# 首次自动生成合法 Fernet key；已有 GitHub token 时不可更换。
GITHUB_TOKEN_ENCRYPTION_KEY=
